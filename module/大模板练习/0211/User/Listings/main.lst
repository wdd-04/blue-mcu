  22          /*按键*/
  23          void Key_Proc()
  24          {
  25   1        if(Key_Slow_Down) return;
  26   1        Key_Slow_Down = 1;
  27   1        
  28   1        Key_Val = Key_Read();
  29   1        Key_Down = Key_Val & (Key_Val ^ Key_Old);
  30   1        Key_Up = ~Key_Val & (Key_Val ^ Key_Old);
  31   1        Key_Old = Key_Val;
