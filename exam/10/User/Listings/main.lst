  58          void Seg_Proc()
  59          {
  60   1        unsigned char i = 3;
  61   1        if(Seg_Slow_Down) return;
  62   1        Seg_Slow_Down = 1;//数码管减速程序
  63   1        
  64   1        V = Ad_Read(0x43)/51.0;
  65   1        if(Output_Mode == 0)
