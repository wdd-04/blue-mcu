  96          /*其他显示函数*/
  97          void Led_Proc()
  98          {
  99   1        unsigned char i;
 100   1        Da_Write(V_Output*51);
 101   1        for(i=0;i<2;i++)
 102   1          ucLed[i] = (i == Seg_Disp_Mode);
 103   1        ucLed[2] = ((V >= 1.5 && V < 2.5)||(V >= 3.5));
 104   1        ucLed[3] = ((Freq >= 1000 && Freq < 5000)||(Freq >= 10000));
 105   1        ucLed[5] = Output_Mode;
 106   1      }
