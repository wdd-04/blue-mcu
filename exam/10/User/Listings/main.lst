  75   2          Seg_Buf[4] = Freq / 1000 % 10;
  76   2          Seg_Buf[5] = Freq / 100 % 10;
  77   2          Seg_Buf[6] = Freq / 10 % 10;
  78   2          Seg_Buf[7] = Freq / 1 % 10;
  79   2          while(Seg_Buf[i] == 0)
  80   2          {
  81   3            Seg_Buf[i] = 10;
