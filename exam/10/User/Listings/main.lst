  83   3          }
  84   2        }
  85   1        else
  86   1        {
  87   2          Seg_Buf[0] = 12;
  88   2          Seg_Buf[3] = 10;
  89   2          Seg_Buf[4] = 10;  
  90   2          Seg_Buf[5] = (unsigned char)V;
  91   2          Seg_Buf[6] = (unsigned int)(V*100) / 10 % 10;
  92   2          Seg_Buf[7] = (unsigned int)(V*100) / 1 % 10;
  93   2        }
  94   1      }
