 254          void Timer0Init(void)   //1毫秒@12.000MHz
 255          {
 256   1        AUXR &= 0x7F;     //定时器时钟12T模式
 257   1        TMOD &= 0xF0;     //设置定时器模式
 258   1        TMOD |= 0x05;
 259   1        TL0 = 0x00;       //设置定时初始值
 260   1        TH0 = 0x00;       //设置定时初始值
 261   1        TF0 = 0;        //清除TF0标志
 262   1        TR0 = 1;        //定时器0开始计数
 263   1      }
