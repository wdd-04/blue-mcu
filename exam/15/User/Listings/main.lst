 270   1        TL1 = 0x18;       //设置定时初始值
 271   1        TH1 = 0xFC;       //设置定时初始值
 272   1        TF1 = 0;        //清除TF1标志
 273   1        TR1 = 1;        //定时器1开始计时
 274   1        ET1 = 1;
 275   1        EA = 1;
 276   1      }
