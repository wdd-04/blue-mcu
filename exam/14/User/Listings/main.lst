 330          void Timer0Init(void)   //1毫秒@12.000MHz
 331          {
 332   1        AUXR &= 0x7F;     //定时器时钟12T模式
 333   1        TMOD &= 0xF0;     //设置定时器模式
 334   1        TMOD |= 0x05;
 335   1        TL0 = 0x00;       //设置定时初始值
 336   1        TH0 = 0x00;       //设置定时初始值
 337   1        TF0 = 0;        //清除TF0标志
 338   1        TR0 = 1;        //定时器0开始计数
 339   1      }
