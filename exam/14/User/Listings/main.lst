 341          /*定时器1中断初始化函数*/
 342          void Timer1Init(void)   //1毫秒@12.000MHz
 343          {
 344   1        AUXR &= 0xBF;     //定时器时钟12T模式
 345   1        TMOD &= 0x0F;     //设置定时器模式
 346   1        TL1 = 0x18;       //设置定时初始值
 347   1        TH1 = 0xFC;       //设置定时初始值
 348   1        TF1 = 0;        //清除TF1标志
 349   1        TR1 = 1;        //定时器1开始计时
 350   1        ET1 = 1;
 351   1        EA = 1;
 352   1      }
