 138          /*定时器0中断初始化函数*/
 139          void Timer0Init(void)   //1毫秒@12.000MHz
 140          {
 141   1        AUXR &= 0x7F;     //定时器时钟12T模式
 142   1        TMOD &= 0xF0;     //设置定时器模式
 143   1        TL0 = 0x18;       //设置定时初始值
 144   1        TH0 = 0xFC;       //设置定时初始值
 145   1        TF0 = 0;        //清除TF0标志
