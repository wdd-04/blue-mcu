 246          /*定时器1初始化函数*/
 247          void Timer1Init(void)   //1毫秒@12.000MHz
 248          {
 249   1        AUXR &= 0xBF;     //定时器时钟12T模式
 250   1        TMOD &= 0x0F;     //设置定时器模式
 251   1        TL1 = 0x18;       //设置定时初始值
 252   1        TH1 = 0xFC;       //设置定时初始值
 253   1        TF1 = 0;        //清除TF1标志
 254   1        TR1 = 1;        //定时器1开始计时
 255   1        ET1 = 1;
 256   1        EA = 1;
 257   1      }
 258          
 259          /*定时器0计次函数*/
 260          void Timer0Init(void)   //1毫秒@12.000MHz
 261          {
 262   1        AUXR &= 0x7F;     //定时器时钟12T模式
 263   1        TMOD &= 0xF0;     //设置定时器模式
 264   1        TMOD |= 0X05;
 265   1        TL0 = 0x00;       //设置定时初始值
 266   1        TH0 = 0x00;       //设置定时初始值
 267   1        TF0 = 0;        //清除TF0标志
 268   1        TR0 = 1;        //定时器0开始计时
 269   1      }
