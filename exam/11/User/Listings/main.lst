 128          /*定时器0中断初始化函数*/
 129          void Timer0Init(void)   //1毫秒@12.000MHz
 130          {
 131   1        AUXR &= 0x7F;     //定时器时钟12T模式
 132   1        TMOD &= 0xF0;     //设置定时器模式
 133   1        TL0 = 0x18;       //设置定时初始值
 134   1        TH0 = 0xFC;       //设置定时初始值
 135   1        TF0 = 0;        //清除TF0标志
 136   1        TR0 = 1;        //定时器0开始计时
 137   1        ET0 = 1;        //定时器0中断打开
 138   1        EA = 1;       //总中断打开
 139   1      }
 140          
 141          /*定时器0中断服务函数*/
 142          void Timer0Server() interrupt 1
 143          {
